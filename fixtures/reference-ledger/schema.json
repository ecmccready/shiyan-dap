{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ecmccready/shiyan-dap/fixtures/reference-ledger/schema.json",
  "title": "Shiyan Reference Data Ledger",
  "description": "A result is not a verified reference until evidence.labels includes physically_measured from a run on the supported board (ECP5 Versa, LFE5UM-45F). Simulated and routed results stay pending. There is no promise that an arbitrary RTL upload becomes an optimized chip. The initial path is a controlled workload assessment for that one FPGA target.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "power", "naming", "records"],
  "properties": {
    "format": { "const": "shiyan-reference-ledger" },
    "power": { "const": "needs real board" },
    "naming": { "type": "string" },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "source"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reference_status",
        "workload_identity",
        "input_conditions",
        "baseline",
        "experiment",
        "build_provenance",
        "implementation",
        "hardware_target",
        "validation",
        "evidence",
        "outcome",
        "audit",
        "numbers"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "reference_status": {
          "enum": [
            "reference (routed + simulated), physical verification pending",
            "stopped (simulated + routed), not a verified reference",
            "pass (simulated + routed), physical verification pending",
            "verified"
          ]
        },
        "workload_identity": { "type": "string", "minLength": 1 },
        "input_conditions": { "$ref": "#/$defs/text" },
        "baseline": { "$ref": "#/$defs/text" },
        "experiment": { "$ref": "#/$defs/text" },
        "build_provenance": { "$ref": "#/$defs/text" },
        "implementation": { "$ref": "#/$defs/text" },
        "hardware_target": { "$ref": "#/$defs/text" },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "source", "bit_exact"],
          "properties": {
            "summary": { "type": "string", "minLength": 1 },
            "source": { "type": "string", "minLength": 1 },
            "bit_exact": { "type": ["boolean", "null"] }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["labels", "sources"],
          "properties": {
            "labels": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["simulated", "routed", "physically_measured"] }
            },
            "sources": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        },
        "outcome": {
          "type": "object",
          "additionalProperties": false,
          "required": ["verdict", "accepted", "negative", "summary"],
          "properties": {
            "verdict": { "enum": ["PASS", "STOP", "RECORDED"] },
            "accepted": { "type": "boolean" },
            "negative": { "type": "boolean" },
            "summary": { "type": "string", "minLength": 1 }
          }
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pull_requests", "fixtures", "hashes"],
          "properties": {
            "pull_requests": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "fixtures": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "hashes": { "type": "object" }
          }
        },
        "numbers": { "type": "object" }
      }
    }
  }
}
