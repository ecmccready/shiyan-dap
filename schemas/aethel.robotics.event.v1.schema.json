{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shiyan-dap.vercel.app/schemas/aethel.robotics.event.v1.schema.json",
  "title": "Aethel Robotics Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "episode_id",
    "seq",
    "timestamp",
    "monotonic_ns",
    "robot",
    "policy",
    "stage",
    "event_type",
    "safety",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "aethel.robotics.event.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "monotonic_ns": {
      "type": "integer",
      "minimum": 0
    },
    "robot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "controller_version"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "controller_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "id",
        "version"
      ],
      "properties": {
        "family": {
          "enum": [
            "lookback",
            "greedy",
            "other"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stage": {
      "enum": [
        "know",
        "know_how",
        "show",
        "do"
      ]
    },
    "event_type": {
      "enum": [
        "observation",
        "proposal",
        "authorization",
        "command",
        "measurement",
        "intervention",
        "stop",
        "outcome"
      ]
    },
    "state_ref": {
      "type": "string",
      "minLength": 1
    },
    "prediction_ref": {
      "type": "string",
      "minLength": 1
    },
    "command_ref": {
      "type": "string",
      "minLength": 1
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator_present",
        "gateway_approved",
        "estop_active"
      ],
      "properties": {
        "operator_present": {
          "type": "boolean"
        },
        "gateway_approved": {
          "type": "boolean"
        },
        "estop_active": {
          "type": "boolean"
        },
        "protective_stop_active": {
          "type": "boolean"
        },
        "safety_event_code": {
          "type": "string"
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previous_hash",
        "record_hash"
      ],
      "properties": {
        "previous_hash": {
          "type": "string",
          "pattern": "^sha256:[a-fA-F0-9]{64}$"
        },
        "record_hash": {
          "type": "string",
          "pattern": "^sha256:[a-fA-F0-9]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "observation"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "required": [
          "state_ref"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "proposal"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "required": [
          "prediction_ref"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "command"
          }
        },
        "required": [
          "command_ref"
        ]
      },
      "then": {
        "properties": {
          "safety": {
            "properties": {
              "operator_present": {
                "const": true
              },
              "gateway_approved": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
