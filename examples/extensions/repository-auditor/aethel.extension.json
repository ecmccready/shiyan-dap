{
  "api_version": "aethel.extension/v1",
  "id": "com.shiyan.repository-auditor",
  "name": "Repository Auditor",
  "version": "1.0.0",
  "entrypoint": "dist/index.js",
  "mode": "read-only",
  "capabilities": [
    "repository.read",
    "evidence.read"
  ],
  "data_scopes": [
    "repository:connected",
    "evidence:current-run"
  ],
  "tenant_isolation": "required",
  "human_approval": true,
  "output_contracts": [
    "aethel.findings/v1"
  ]
}
